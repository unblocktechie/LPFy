# CRE simulation / broadcast secrets (this folder only — not root or web)

# 64 hex chars, no 0x prefix. Required for --broadcast.
CRE_ETH_PRIVATE_KEY=

# Sepolia HTTP RPC used by CRE (single place for CRE). After changing, run:
#   node sync-rpc.js
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
